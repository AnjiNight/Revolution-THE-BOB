  setor      String?  @db.VarChar(100)
  subsetor   String?  @db.VarChar(100)
  segmento   String?  @db.VarChar(100)
  coletadaEm DateTime @map("coletada_em") @db.Timestamptz(3)

  @@map("classificacao_b3")
}

/// SPEC-027: fonte pai (única, o Investidor10) ou curada (RSS ou Atom, pelo colaborador), DA19.
enum TipoFonteNoticia {
  pai
  curada

  @@map("tipo_fonte_noticia")
}

enum CategoriaNoticia {
  economia
  mercado
  empresas
  internacional

  @@map("categoria_noticia")
}

enum SituacaoArquivoNoticia {
  em_andamento
  concluido

  @@map("situacao_arquivo_noticia")
}

/// SPEC-027: fonte de notícias. `https` obrigatório; a curada tem categoria, confiabilidade (1 a 5)
/// e a data em que o colaborador conferiu a licença; a pai nunca fica inativa.
model FonteNoticia {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo               TipoFonteNoticia
  nome               String            @db.VarChar(80)
  url                String            @unique @db.VarChar(500)
  categoria          CategoriaNoticia?
  confiabilidade     Int?              @db.SmallInt
  ativa              Boolean           @default(true)
  licencaConferidaEm DateTime?         @map("licenca_conferida_em") @db.Timestamptz(3)
  ultimaColetaEm     DateTime?         @map("ultima_coleta_em") @db.Timestamptz(3)
  /// `sucesso` ou `falha`.
  ultimaSituacao     String?           @map("ultima_situacao") @db.VarChar(10)
  ultimoErro         String?           @map("ultimo_erro") @db.VarChar(300)
  falhasSeguidas     Int               @default(0) @map("falhas_seguidas")
  criadaEm           DateTime          @default(now()) @map("criada_em") @db.Timestamptz(3)
  atualizadaEm       DateTime          @default(now()) @map("atualizada_em") @db.Timestamptz(3)

  noticias Noticia[]
  arquivo  ColetaNoticiaArquivo?

  @@map("fonte_noticia")
}

/// SPEC-027: notícia coletada. Texto completo só da fonte pai, para a classificação (SPEC-028).
model Noticia {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fonteId              String             @map("fonte_id") @db.Uuid
  url                  String             @db.VarChar(500)
  titulo               String             @db.VarChar(500)
  resumo               String?
  texto                String?
  autor                String?            @db.VarChar(150)
  temas                String[]           @default([])
  empresasMarcadas     String[]           @default([]) @map("empresas_marcadas")
  publicadaEm          DateTime           @map("publicada_em") @db.Timestamptz(3)
  atualizadaNaFonteEm  DateTime?          @map("atualizada_na_fonte_em") @db.Timestamptz(3)
  coletadaEm           DateTime           @map("coletada_em") @db.Timestamptz(3)
  /// SPEC-028: quando e com qual versão da regra a notícia foi vinculada aos ativos.
  vinculadaEm          DateTime?          @map("vinculada_em") @db.Timestamptz(3)
  versaoVinculo        Int?               @map("versao_vinculo") @db.SmallInt
  /// SPEC-044: o tom da notícia, a pontuação (−1 a 1), quando e por qual versão; vazios = pendente.
  sentimento           SentimentoNoticia?
  sentimentoPontuacao  Decimal?           @map("sentimento_pontuacao") @db.Decimal(4, 3)
  classificadaEm       DateTime?          @map("classificada_em") @db.Timestamptz(3)
  versaoModeloId       Int?               @map("versao_modelo_id")
  /// SPEC-047: a original, quando esta é repetida de outra fonte, e por quê; e quando foi conferida.
  repetidaDeId         String?            @map("repetida_de_id") @db.Uuid
  repetidaPor          MotivoRepeticao?   @map("repetida_por")
  repeticaoConferidaEm DateTime?          @map("repeticao_conferida_em") @db.Timestamptz(3)

  fonte        FonteNoticia   @relation(fields: [fonteId], references: [id], onDelete: Restrict)
  repetidaDe   Noticia?       @relation("RepeticaoNoticia", fields: [repetidaDeId], references: [id], onDelete: SetNull)
  repetidas    Noticia[]      @relation("RepeticaoNoticia")
  ativos       NoticiaAtivo[]
  versaoModelo VersaoModelo?  @relation(fields: [versaoModeloId], references: [id], onDelete: Restrict)
  rotulo       RotuloNoticia?

  @@unique([fonteId, url])
  @@index([publicadaEm])
  @@index([versaoVinculo], map: "noticia_vinculo_idx")
  @@index([versaoModeloId], map: "noticia_versao_modelo_idx")
  @@index([repetidaDeId], map: "noticia_repetida_de_idx")
  @@index([repeticaoConferidaEm], map: "noticia_repeticao_conferida_idx")
  @@map("noticia")
}

/// SPEC-047: por que a notícia é repetida de outra (o mesmo endereço ou o título quase igual).
enum MotivoRepeticao {
  endereco
  titulo

  @@map("motivo_repeticao")
}

/// SPEC-044: positivo, neutro ou negativo, do modelo ou do rótulo da equipe.
enum SentimentoNoticia {
  positivo
  neutro
  negativo

  @@map("sentimento_noticia")
}

enum SituacaoVersaoModelo {
  em_uso
  retirada

  @@map("situacao_versao_modelo")
}

/// SPEC-044 (DA20): cada versão do modelo de sentimento, com a nota da última avaliação.
model VersaoModelo {
  id           Int                  @id @default(autoincrement())
  nome         String               @db.VarChar(40)
  numero       Int
  situacao     SituacaoVersaoModelo
  criadaEm     DateTime             @map("criada_em") @db.Timestamptz(3)
  avaliadaEm   DateTime?            @map("avaliada_em") @db.Timestamptz(3)
  amostraTeste Int?                 @map("amostra_teste")
  acuracia     Decimal?             @db.Decimal(4, 3)
  f1Macro      Decimal?             @map("f1_macro") @db.Decimal(4, 3)
  /// Linhas: o rótulo; colunas: o modelo (positivo, neutro, negativo).
  matriz       Json?

  noticias Noticia[]

  @@unique([nome, numero])
  @@map("versao_modelo")
}

/// SPEC-044: o rótulo da equipe para a amostra; sem a pessoa (§4.2).
model RotuloNoticia {
  noticiaId  String            @id @map("noticia_id") @db.Uuid
  sentimento SentimentoNoticia
  rotuladoEm DateTime          @map("rotulado_em") @db.Timestamptz(3)

  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@map("rotulo_noticia")
}

/// SPEC-028: o ativo é o assunto (principal), aparece no texto (citado) ou a notícia é uma lista.
enum RelevanciaNoticia {
  principal
  citado
  lista

  @@map("relevancia_noticia")
}

enum OrigemVinculoNoticia {
  ticker_titulo
  ticker_texto
  empresa_marcada

  @@map("origem_vinculo_noticia")
}

/// SPEC-028: vínculo notícia–ativo (RF27).
model NoticiaAtivo {
  noticiaId  String               @map("noticia_id") @db.Uuid
  ativoId    String               @map("ativo_id") @db.Uuid
  relevancia RelevanciaNoticia
  origem     OrigemVinculoNoticia

  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)
  ativo   Ativo   @relation(fields: [ativoId], references: [id], onDelete: Restrict)

  @@id([noticiaId, ativoId])
  @@index([ativoId, relevancia], map: "noticia_ativo_ativo_idx")
  @@map("noticia_ativo")
}

/// SPEC-027 §4.1, decisão 3: andamento da carga do arquivo da fonte pai.
model ColetaNoticiaArquivo {
  fonteId      String                 @id @map("fonte_id") @db.Uuid
  total        Int
  feitas       Int
  situacao     SituacaoArquivoNoticia
  atualizadaEm DateTime               @map("atualizada_em") @db.Timestamptz(3)

  fonte FonteNoticia @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@map("coleta_noticia_arquivo")
}
