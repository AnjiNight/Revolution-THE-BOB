# Copie para api/.env e ajuste.
# Banco local criado pelo docker compose (npm run db:up)
DATABASE_URL=postgresql://simulador:simulador@localhost:5432/simulador
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
NODE_ENV=development
# Segredo que assina os tokens de acesso (mínimo 32 caracteres). Troque em produção.
JWT_SECRET=desenvolvimento-troque-este-segredo-em-producao-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# Login com Google (DA24): client ID do app (tipo "Aplicativo para computador"). Vazio = desligado.
GOOGLE_CLIENT_ID=
WORKER_HEARTBEAT_SECONDS=60
# Histórico de cotações (SPEC-008): pasta onde o processador guarda os arquivos anuais da B3
# (uns 60 a 90 MB por ano). Relativa à pasta api/.
B3_CACHE_DIR=.cache/b3
# Cotações e lista de ativos (SPECs 009 e 040): token do plano gratuito da brapi. OPCIONAL: a lista
# responde sem token e não desconta da cota. Quem usar um GERA O PRÓPRIO em https://brapi.dev (a
# cota de 15 mil consultas por mês é por chave).
BRAPI_TOKEN=
# Consultas por mês do plano, se a brapi passar a descontar a lista (o processador usa no máximo 90%).
BRAPI_MONTHLY_QUOTA=15000
# Série do CDI (SPEC-007): API SGS do Banco Central, pública e sem token. Só muda nos testes.
BCB_SGS_BASE_URL=https://api.bcb.gov.br
# Indicadores e proventos (SPECs 041 e 042): Investidor10, SÓ com a autorização por escrito da equipe
# (uso acadêmico neste projeto, "Fonte: Investidor10", válida até a apresentação). Sem autorização,
# deixe false: os termos de uso do site proíbem baixar o conteúdo.
INVESTIDOR10_ENABLED=false
# Eventos corporativos (SPEC-042): página das empresas no site da B3.
B3_LISTED_BASE_URL=https://sistemaswebb3-listados.b3.com.br
# E-mail (SPEC-004 e SPEC-039): confirmação do cadastro, troca de e-mail e recuperação de senha.
# SMTP_HOST vazio desliga essas funções (só fora de produção; em produção o servidor não inicia).
# Desenvolvimento: Mailpit (npm run mail:up) e a caixa de entrada em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Simulador de Investimentos <nao-responda@simulador.local>
